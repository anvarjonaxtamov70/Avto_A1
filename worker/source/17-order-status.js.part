async function claimOrderStatus(ctx, token, orderKey, currentStatus, targetStatus, owner) {
  const path = "order_state/" + orderKey;
  const now = Date.now();
  const result = await rtdbEtagMutate(ctx.dbUrl, path, token, (raw) => {
    const state = raw && typeof raw === "object"
      ? cloneJson(raw)
      : { current: currentStatus, pending: null, version: 0 };
    if (state.pending) {
      if (Number(state.pending.leaseUntil) > now) {
        throw httpError(409, "status o'zgarishi bajarilmoqda", { retryable: true });
      }
      if (state.pending.target !== targetStatus) {
        throw httpError(409, "avvalgi status o'zgarishini shu target bilan davom ettiring", {
          pendingStatus: state.pending.target,
        });
      }
      state.pending.owner = owner;
      state.pending.ownerGeneration = Math.max(0, Number(state.pending.ownerGeneration) || 0) + 1;
      state.pending.leaseUntil = now + STATUS_LEASE_MS;
      state.updatedAt = now;
      return { value: state, result: { state, claimed: true, takeover: true } };
    }
    if (state.current === targetStatus) {
      if (currentStatus !== targetStatus) {
        throw httpError(409, "order_state va canonical status mos emas", { canonicalStatus: currentStatus });
      }
      return { abort: true, result: { state, already: true } };
    }
    if (currentStatus === targetStatus) {
      state.current = targetStatus;
      state.pending = null;
      state.updatedAt = now;
      return { value: state, result: { state, already: true, reconciled: true } };
    }
    if (state.current !== currentStatus) {
      throw httpError(409, "canonical status va transition holati mos emas");
    }
    const allowed = ORDER_TRANSITIONS[state.current] || [];
    if (!allowed.includes(targetStatus)) {
      throw httpError(409, "status o'tishi mumkin emas", { from: state.current, to: targetStatus });
    }
    const transitionVersion = (Number(state.version) || 0) + 1;
    state.pending = {
      target: targetStatus,
      from: state.current,
      owner,
      ownerGeneration: 1,
      transitionVersion,
      leaseUntil: now + STATUS_LEASE_MS,
    };
    state.version = transitionVersion;
    state.updatedAt = now;
    return { value: state, result: { state, claimed: true } };
  });
  return result.result;
}

function retryableInventoryConflict(message, extra) {
  throw httpError(409, message, { retryable: true, ...(extra || {}) });
}

async function resolveOrderStockItems(ctx, token, order) {
  const products = toEntries(await rtdbGet(ctx.dbUrl, "products", token));
  let sourceItems;
  if (Array.isArray(order.itemDetails) && order.itemDetails.length) {
    sourceItems = order.itemDetails;
  } else {
    const rawItems = order.items && typeof order.items === "object" ? order.items : {};
    sourceItems = Object.keys(rawItems).map((key, index) => {
      // Eski savat kalitlari: "id" (addToCart(id) — razmersiz), "id||razmer"
      // yoki "id||<mashina modeli>". Eski Mini App razmerdagi nuqtani "_dot_"
      // qilib saqlagan ("92_dot_5").
      const separator = key.indexOf("||");
      const id = separator > 0 ? key.slice(0, separator) : key;
      if (!id) retryableInventoryConflict("buyurtma mahsulotlarini tiklab bo'lmaydi", { itemKey: key });
      let legacySize = separator > 0 ? key.slice(separator + 2).split("_dot_").join(".") : "";
      if (!legacySize || legacySize === "undefined") legacySize = "Universal";
      return {
        lineKey: "legacy_" + index,
        id,
        size: legacySize,
        qty: Number(rawItems[key]),
        legacy: true,
      };
    });
  }
  if (!sourceItems.length) retryableInventoryConflict("buyurtmada tiklanadigan mahsulot yo'q");

  // ⚠️ Tiklab bo'lmaydigan qator (mahsulot o'chirilgan, razmer olib tashlangan)
  //    ilgari BEKOR QILISHNI butunlay bloklardi: har urinishda 409 qaytardi va
  //    buyurtma abadiy "ochiq" qolardi. Endi bunday qator O'TKAZIB yuboriladi
  //    (o'chirilgan tovarni omborga qaytarib bo'lmaydi) va `skipped` ro'yxatida
  //    adminga ko'rsatiladi. Noaniq holat (bir id — bir nechta tovar) ham
  //    xavfli taxmin o'rniga o'tkazib yuboriladi.
  // Massiv + qo'shimcha `skipped` maydoni (JSDoc: muharrir tekshiruvi uchun)
  /** @type {any} */
  const out = [];
  out.skipped = [];
  const lineKeys = new Set();
  for (let index = 0; index < sourceItems.length; index++) {
    const item = sourceItems[index];
    if (!item || typeof item !== "object") retryableInventoryConflict("buyurtma mahsuloti noto'g'ri", { index });
    const id = String(item.id || "");
    const qty = Number(item.qty);
    const lineKey = String(item.lineKey || ("i" + index));
    const size = String(item.size || "Universal");
    if (!id || id.length > 200 || !Number.isSafeInteger(qty) || qty <= 0 ||
        !/^[A-Za-z0-9_-]{1,80}$/.test(lineKey) || lineKeys.has(lineKey)) {
      retryableInventoryConflict("buyurtma mahsuloti yoki miqdori noto'g'ri", { index, id });
    }
    lineKeys.add(lineKey);

    const skip = (reason) => out.skipped.push({ id, size, qty, name: String(item.name || id), reason });
    const idMatches = products.filter((entry) => String(entry.val.id) === id);
    const storedProduct = item.productKey != null
      ? products.find((entry) => entry.key === String(item.productKey))
      : null;
    const storedOk = !!storedProduct && String(storedProduct.val.id) === id;
    if (!storedOk && idMatches.length !== 1) {
      skip(idMatches.length ? "noaniq mahsulot" : "mahsulot o'chirilgan");
      continue;
    }
    const productHit = storedOk ? storedProduct : idMatches[0];
    const sizeEntries = toEntries(productHit.val.sizes);
    const isSized = productHit.val.product_type === "razmerli" || sizeEntries.length > 0;
    let sizeKey = null;
    let effectiveSize = size;
    if (item.legacy === true && !isSized && size !== "Universal") {
      // Eski kalitdagi "razmer" aslida mashina modeli (razmersiz tovar) —
      // umumiy stokka qaytariladi.
      effectiveSize = "Universal";
    } else if (size !== "Universal") {
      const sizeMatches = sizeEntries.filter((entry) => String(entry.val.size) === size);
      if (sizeMatches.length !== 1) {
        skip("razmer topilmadi");
        continue;
      }
      sizeKey = sizeMatches[0].key;
    } else if (isSized) {
      skip("razmer ko'rsatilmagan");
      continue;
    }
    out.push({
      lineKey,
      id,
      name: String(productHit.val.name || item.name || id),
      size: effectiveSize,
      qty,
      productKey: productHit.key,
      sizeKey,
    });
  }
  return out;
}

async function restockOperationKey(orderKey) {
  return "r_" + (await sha256Hex("restock|" + orderKey)).slice(0, 36);
}

async function restockOrderOnce(ctx, token, orderKey, items, owner, pending, clock) {
  const opKey = await restockOperationKey(orderKey);
  const results = [];
  for (const item of items) {
    if (!Number.isSafeInteger(item.qty) || item.qty <= 0) {
      retryableInventoryConflict("tiklash miqdori noto'g'ri", { productId: item.id });
    }
    await renewStatusLeaseIfDue(ctx, token, orderKey, owner, pending, clock);
    const mutation = await rtdbEtagMutate(ctx.dbUrl, "products/" + item.productKey, token, (current) => {
      if (!current || String(current.id) !== String(item.id)) {
        retryableInventoryConflict("mahsulot joyi o'zgargan", { productId: item.id });
      }
      const product = cloneJson(current);
      product._orderOperations = product._orderOperations && typeof product._orderOperations === "object"
        ? product._orderOperations
        : {};
      const marker = product._orderOperations[opKey] && typeof product._orderOperations[opKey] === "object"
        ? product._orderOperations[opKey]
        : { items: {} };
      marker.items = marker.items && typeof marker.items === "object" ? marker.items : {};
      if (marker.items[item.lineKey] && marker.items[item.lineKey].done === true) {
        return { abort: true, result: { duplicate: true, productKey: item.productKey, lineKey: item.lineKey } };
      }
      if (item.sizeKey !== null) {
        if (!product.sizes || !product.sizes[item.sizeKey] ||
            String(product.sizes[item.sizeKey].size) !== item.size) {
          retryableInventoryConflict("mahsulot razmeri o'zgargan", { productId: item.id, size: item.size });
        }
        product.sizes[item.sizeKey].stock = Math.max(0, Number(product.sizes[item.sizeKey].stock) || 0) + item.qty;
        if (product.stock != null) product.stock = Math.max(0, Number(product.stock) || 0) + item.qty;
      } else {
        const sizeEntries = toEntries(product.sizes);
        if (item.size !== "Universal" || product.product_type === "razmerli" || sizeEntries.length) {
          retryableInventoryConflict("mahsulot razmer turi o'zgargan", { productId: item.id });
        }
        product.stock = Math.max(0, Number(product.stock) || 0) + item.qty;
      }
      marker.items[item.lineKey] = { done: true, qty: item.qty };
      product._orderOperations[opKey] = marker;
      return { value: product, result: { restocked: true, productKey: item.productKey, lineKey: item.lineKey } };
    });
    const lineResult = mutation.result;
    if (!lineResult || (!lineResult.restocked && !lineResult.duplicate)) {
      retryableInventoryConflict("mahsulot stoki tiklanmadi", { productId: item.id });
    }
    results.push(lineResult);
  }
  if (results.length !== items.length) retryableInventoryConflict("barcha mahsulot stoki tiklanmadi");
  return { opKey, results };
}

async function cleanRestockMarkers(ctx, token, orderKey, touchedItems) {
  const opKey = await restockOperationKey(orderKey);
  const products = toEntries(await rtdbGet(ctx.dbUrl, "products", token));
  const productKeys = new Set((touchedItems || []).map((item) => String(item.productKey)));
  for (const entry of products) {
    if (entry.val._orderOperations && entry.val._orderOperations[opKey]) productKeys.add(entry.key);
  }
  for (const productKey of productKeys) {
    await rtdbEtagMutate(ctx.dbUrl, "products/" + productKey, token, (current) => {
      if (!current || !current._orderOperations || !current._orderOperations[opKey]) {
        return { abort: true, result: { cleaned: true } };
      }
      const product = cloneJson(current);
      delete product._orderOperations[opKey];
      if (!Object.keys(product._orderOperations).length) delete product._orderOperations;
      return { value: product, result: { cleaned: true } };
    });
  }
}

async function applyStatusLoyalty(ctx, token, uid, order, targetStatus) {
  const orderKeyHash = (await sha256Hex(String(order.uid) + "_" + String(order.id))).slice(0, 36);
  if (targetStatus === "yetkazildi") {
    const amount = Math.max(0, Math.round((Number(order.payable) || 0) * (Number(order.cbRate) || 0)));
    return await mutateLoyalty(ctx, token, uid, "earn_" + orderKeyHash, (account) => {
      account.earned = Math.max(0, Number(account.earned) || 0) + amount;
      return { type: "earn", amount, orderId: String(order.id) };
    });
  }
  if (targetStatus === "bekor_qilingan") {
    return await mutateLoyalty(ctx, token, uid, "cancel_" + orderKeyHash, (account) => {
      const cashbackRefund = Math.max(0, Number(order.cashbackUsed) || 0);
      const earnOp = account.ops && account.ops["earn_" + orderKeyHash];
      const earnedReversal = earnOp ? Math.max(0, Number(earnOp.amount) || 0) : 0;
      account.refunded = Math.max(0, Number(account.refunded) || 0) + cashbackRefund;
      account.reversed = Math.max(0, Number(account.reversed) || 0) + earnedReversal;
      return { type: "cancel", cashbackRefund, earnedReversal, orderId: String(order.id) };
    });
  }
  // qabul / yo'lda — cashback o'zgarmaydi: bazaga umuman bormaymiz. Ilgari
  // shu yerda hisob o'qilar va proyeksiya qayta yozilardi (har bosishda
  // ~4-6 ta ortiqcha ketma-ket so'rov — admin tugmasi shuning uchun sekin edi).
  return { account: null, operation: { type: "status", amount: 0 }, duplicate: true };
}

async function renewStatusLease(ctx, token, orderKey, owner, pending) {
  const result = await rtdbEtagMutate(ctx.dbUrl, "order_state/" + orderKey, token, (current) => {
    if (!current || !current.pending || current.pending.owner !== owner ||
        Number(current.pending.transitionVersion) !== Number(pending.transitionVersion) ||
        Number(current.pending.ownerGeneration) !== Number(pending.ownerGeneration)) {
      throw httpError(409, "status lease egasi o'zgargan", { retryable: true });
    }
    const next = cloneJson(current);
    next.pending.leaseUntil = Date.now() + STATUS_LEASE_MS;
    next.updatedAt = Date.now();
    return { value: next, result: next };
  });
  return result.result || result.value;
}

async function renewStatusLeaseIfDue(ctx, token, orderKey, owner, pending, clock) {
  if (!leaseDue(clock)) return;
  const next = await renewStatusLease(ctx, token, orderKey, owner, pending);
  if (clock) clock.at = leaseClock(next && next.pending && next.pending.leaseUntil, STATUS_LEASE_MS).at || Date.now();
}

async function commitCanonicalStatus(ctx, token, orderPath, uid, orderId, fromStatus, targetStatus) {
  const result = await rtdbEtagMutate(ctx.dbUrl, orderPath, token, (current) => {
    if (!current || String(current.uid) !== uid || String(current.id) !== orderId) {
      throw httpError(404, "buyurtma topilmadi");
    }
    const currentStatus = String(current.status || "kutilmoqda");
    if (currentStatus === targetStatus) return { abort: true, result: { order: current, duplicate: true } };
    if (currentStatus !== fromStatus) {
      throw httpError(409, "canonical status boshqa holatga o'tgan", { currentStatus });
    }
    const next = cloneJson(current);
    next.status = targetStatus;
    next.statusUpdatedAt = Date.now();
    return { value: next, result: { order: next, duplicate: false } };
  });
  return result.result;
}

async function completeStatusTransition(ctx, token, orderKey, owner, pending, targetStatus) {
  const result = await rtdbEtagMutate(ctx.dbUrl, "order_state/" + orderKey, token, (current) => {
    if (current && current.current === targetStatus && !current.pending) {
      return { abort: true, result: { state: current, duplicate: true } };
    }
    if (!current || !current.pending || current.pending.owner !== owner ||
        Number(current.pending.transitionVersion) !== Number(pending.transitionVersion) ||
        Number(current.pending.ownerGeneration) !== Number(pending.ownerGeneration) ||
        current.pending.target !== targetStatus) {
      throw httpError(409, "status yakunlovchisi eskirgan", { retryable: true });
    }
    const next = {
      current: targetStatus,
      pending: null,
      version: Number(current.version) || Number(pending.transitionVersion),
      lastTransition: {
        from: pending.from,
        target: targetStatus,
        transitionVersion: Number(pending.transitionVersion),
      },
      updatedAt: Date.now(),
    };
    return { value: next, result: { state: next, duplicate: false } };
  });
  return result.result;
}

async function reconcileUserOrderStatus(ctx, token, uid, orderId, fromStatus, targetStatus, userKey) {
  const mutateAt = async (key) => {
    const res = await rtdbEtagMutate(ctx.dbUrl, "users/" + uid + "/orders/" + key, token, (current) => {
      // Kalit boshqa buyurtmaga tegishli bo'lsa (eski MASSIV indekslari) — tegmaymiz.
      if (!current || typeof current !== "object" || String(current.id) !== String(orderId)) {
        return { abort: true, result: { found: false } };
      }
      const status = String(current.status || "kutilmoqda");
      if (status === targetStatus) return { abort: true, result: { found: true } };
      if (status !== fromStatus) return { abort: true, result: { found: true } };
      const next = cloneJson(current);
      next.status = targetStatus;
      next.statusUpdatedAt = Date.now();
      return { value: next, result: { found: true } };
    });
    return !!(res.result && res.result.found);
  };
  if (await mutateAt(orderId)) return;
  // Eski (legacy) buyurtma: `users/{uid}/orders` massiv bo'lgan, kalit = indeks.
  if (userKey != null && String(userKey) !== String(orderId) && await mutateAt(String(userKey))) return;
  const all = toEntries(await rtdbGet(ctx.dbUrl, "users/" + uid + "/orders", token));
  const hit = all.find((entry) => String(entry.val.id) === String(orderId));
  if (hit && hit.key !== String(orderId) && hit.key !== String(userKey)) await mutateAt(hit.key);
}

// Eski (server-authoritative davridan OLDINGI) buyurtma faqat
// `users/{uid}/orders` da bo'ladi — markaziy `orders/` yozuvi yo'q. Ilgari
// bunday buyurtmaning holatini o'zgartirib bo'lmasdi (doim 404). Endi u bir
// marta markaziy yozuvga "ko'chiriladi" va keyin odatdagi holat mashinasi,
// stok qaytarish va cashback bilan ishlaydi.
async function adoptLegacyOrder(ctx, token, uid, orderId) {
  const all = toEntries(await rtdbGet(ctx.dbUrl, "users/" + uid + "/orders", token));
  const hit = all.find((entry) => String(entry.val.id) === String(orderId));
  if (!hit) return null;
  const legacy = cloneJson(hit.val);
  // Yangi (Worker yozgan) buyurtmaning markaziy yozuvi yo'qolgan bo'lsa —
  // bu ko'chirish emas, ma'lumot buzilishi. Taxmin qilmaymiz.
  if (legacy.payloadHash) return null;
  delete legacy.messages;
  const status = ORDER_STATUSES.includes(String(legacy.status)) ? String(legacy.status) : "kutilmoqda";
  const total = Math.max(0, Math.round(Number(legacy.total) || 0));
  const cashbackUsed = Math.min(total, Math.max(0, Math.round(Number(legacy.cashbackUsed) || 0)));
  const payable = legacy.payable != null && Number.isFinite(Number(legacy.payable))
    ? Math.max(0, Math.round(Number(legacy.payable)))
    : total - cashbackUsed;
  const cbRate = Number(legacy.cbRate) > 0 && Number(legacy.cbRate) < 1 ? Number(legacy.cbRate) : 0.008;
  const adopted = {
    ...legacy,
    id: String(orderId),
    uid,
    code: String(legacy.code || orderId),
    status,
    total,
    cashbackUsed,
    payable,
    cbRate,
    legacyAdopted: true,
    // Ko'chirish paytidagi holat. Bu holatgacha bo'lgan cashback/ombor amallarini
    // ESKI mijoz kodi bajargan — server ularni qayta bajarmasligi SHART.
    legacyStatus: status,
    legacyUserKey: hit.key,
    adoptedAt: Date.now(),
  };
  delete adopted.statusUpdatedAt;
  const created = await rtdbCreateIfNull(
    ctx.dbUrl,
    "orders/" + uid + "_" + orderId,
    adopted,
    token,
    (value) => value && String(value.uid) === uid && String(value.id) === String(orderId)
  );
  return created.value;
}

// `loyaltyResult` — asosiy oqim cashbackni ALLAQACHON qo'llagan bo'lsa, o'sha
// natija (ilgari shu yerda applyStatusLoyalty IKKINCHI marta chaqirilardi —
// amal idempotent, lekin 3-4 ta ortiqcha ketma-ket so'rov edi).
async function publishStatusProjections(ctx, token, uid, orderId, orderKey, order, fromStatus, targetStatus, transitionVersion, actor, loyaltyResult) {
  const loyalty = loyaltyResult || await applyStatusLoyalty(ctx, token, uid, order, targetStatus);
  const processed = {
    st: targetStatus,
    cb: targetStatus === "yetkazildi" ? Math.max(0, Number(loyalty.operation.amount) || 0) : 0,
    ur: targetStatus === "bekor_qilingan" ? Math.max(0, Number(loyalty.operation.cashbackRefund) || 0) : 0,
    rv: targetStatus === "bekor_qilingan" ? Math.max(0, Number(loyalty.operation.earnedReversal) || 0) : 0,
  };
  const outboxKey = orderKey + "_status_" + transitionVersion;
  // ⚡ Uch mustaqil yo'l PARALLEL (ilgari 4 ta ketma-ket ETag yozuvi edi).
  //    `users/{uid}/phase2` ichidagi ikki yozuv esa KETMA-KET: ular bitta ota
  //    tugunda — parallel bo'lsa ETag to'qnashib, behuda qayta urinardi.
  await Promise.all([
    reconcileUserOrderStatus(ctx, token, uid, orderId, fromStatus, targetStatus, order.legacyUserKey),
    (async () => {
      if (loyalty.account) await writeLoyaltyProjection(ctx, token, uid, loyalty.account);
      await rtdbCreateIfNull(
        ctx.dbUrl,
        "users/" + uid + "/phase2/processedOrders/" + orderId + "_v" + transitionVersion,
        processed,
        token,
        (value) => value && value.st === targetStatus
      );
    })(),
    rtdbCreateIfNull(
      ctx.dbUrl,
      "notification_outbox/" + outboxKey,
      {
        type: "order_status", uid, orderKey, orderId, from: fromStatus, status: targetStatus,
        createdAt: Date.now(), delivered: false, transitionVersion,
        retryAt: Date.now() + ORDER_RETRY_FIRST_MS,
        by: (actor && actor.role) || "admin",
        byUid: (actor && actor.uid) || null,
        byName: (actor && actor.name) || null,
      },
      token,
      (value) => value && value.status === targetStatus && Number(value.transitionVersion) === Number(transitionVersion)
    ),
  ]);
  return { ...processed, outboxKey };
}

async function handleOrderStatus(request, env, execCtx) {
  let claimed = false;
  try {
    const body = await readJsonBody(request);
    const uid = requireSafeUid(cleanText(body.uid, 128, true), 400);
    const orderId = cleanText(body.orderId, 80, true);
    if (!/^[A-Za-z0-9_-]{1,80}$/.test(orderId)) throw httpError(400, "uid yoki orderId noto'g'ri");
    const status = cleanText(body.status, 32, true);
    if (!ORDER_STATUSES.includes(status)) throw httpError(400, "status noto'g'ri");
    // expectedFrom (ixtiyoriy): "faqat hozirgi holat shu bo'lsa o'zgartir".
    // AI agenti tasdiq kartochkasidagi holat eskirgan bo'lsa yozmasligi uchun.
    const expectedFrom = body.expectedFrom == null || body.expectedFrom === ""
      ? ""
      : cleanText(body.expectedFrom, 32, true);
    if (expectedFrom && !ORDER_STATUSES.includes(expectedFrom)) throw httpError(400, "expectedFrom noto'g'ri");

    // notifyMode:"split" — chaqiruvchi (yangi ilova / bot) xabarni javobdan
    // keyin alohida so'rovda turtadi (/order-deliver yoki /order-notify).
    const notifyMode = body.notifyMode === "split" ? "split" : "inline";
    const identity = body.botAuth != null
      ? await verifyBotAuth(body, env, "order-status", [uid, orderId, status, expectedFrom])
      : await authenticateBody(body, env);
    const isAdmin = getAdminIds(env).includes(identity.uid);
    // 👤 Mijoz FAQAT o'zining, hali qabul qilinmagan buyurtmasini bekor qila oladi.
    if (!isAdmin) {
      if (identity.uid !== uid) throw httpError(403, "faqat admin");
      if (status !== "bekor_qilingan") throw httpError(403, "mijoz faqat bekor qila oladi");
    }
    const actor = {
      role: isAdmin ? "admin" : "customer",
      uid: identity.uid,
      name: identity.claims && typeof identity.claims === "object"
        ? cleanText(String(identity.claims.first_name || identity.claims.name || ""), 64, false) || null
        : null,
      via: identity.source,
    };

    const ctx = getDbContext(env);
    const token = await getAccessToken(env);
    const orderKey = uid + "_" + orderId;
    const orderPath = "orders/" + orderKey;
    let order = await rtdbGet(ctx.dbUrl, orderPath, token);
    if (!order) order = await adoptLegacyOrder(ctx, token, uid, orderId);
    if (!order || String(order.uid) !== uid || String(order.id) !== orderId) throw httpError(404, "buyurtma topilmadi");

    const canonicalStatus = String(order.status || "kutilmoqda");
    // Hech qaysi holatdan "kutilmoqda" ga o'tib bo'lmaydi.
    if (status === "kutilmoqda") {
      throw httpError(409, "status o'tishi mumkin emas", { from: canonicalStatus, to: status });
    }
    // 🧓 ESKI (ko'chirilgan) buyurtma: uning holati, cashback va ombor amallari
    //    eski mijoz kodida bajarilgan va server ularni ko'rmagan. Shu sababli:
    //    • mijoz uni o'zi bekor qila olmaydi (holat yolg'on "kutilmoqda" bo'lishi
    //      mumkin — tovar aslida berilgan);
    //    • eski oqimda yetkazilgan buyurtmani "qaytarish" bloklanadi (berilgan
    //      cashbackni server bilmaydi — qaytarib ololmaydi, faqat ishlatilganini
    //      yana qaytarib yuborardi);
    //    • server hali tegmagan eski buyurtmaga takroriy so'rov hech qanday
    //      cashback/xabar amalini bajarmaydi (pastda).
    const legacyUntouched = order.legacyAdopted === true && order.statusUpdatedAt == null;
    if (!isAdmin && order.legacyAdopted === true) {
      throw httpError(403, "eski buyurtmani bekor qilish uchun do'kon bilan bog'laning");
    }
    if (legacyUntouched && canonicalStatus === "yetkazildi" && status === "bekor_qilingan") {
      throw httpError(409, "eski (yangilanishdan oldingi) yetkazilgan buyurtmani qaytarib bo'lmaydi — ombor va cashbackni qo'lda to'g'rilang", {
        currentStatus: canonicalStatus,
      });
    }
    if (expectedFrom && canonicalStatus !== expectedFrom && canonicalStatus !== status) {
      throw httpError(409, "holat allaqachon o'zgargan", { currentStatus: canonicalStatus });
    }
    if (!isAdmin && canonicalStatus !== "kutilmoqda" && canonicalStatus !== status) {
      throw httpError(409, "buyurtma allaqachon qabul qilingan — bekor qilish uchun do'kon bilan bog'laning", {
        currentStatus: canonicalStatus,
      });
    }

    const owner = randomOwnerToken();
    const claim = await claimOrderStatus(
      ctx, token, orderKey, String(order.status || "kutilmoqda"), status, owner
    );
    if (claim.already) {
      if (legacyUntouched) {
        // Eski oqimda allaqachon shu holatga o'tgan — cashback/xabar QAYTA
        // bajarilmaydi (aks holda ishlatilgan cashback ikkinchi marta qaytardi).
        return json({ ok: true, duplicate: true, orderKey, status, notify: "server" });
      }
      const last = claim.state.lastTransition && claim.state.lastTransition.target === status
        ? claim.state.lastTransition
        : { from: status, transitionVersion: Number(claim.state.version) || 0 };
      if (status === "bekor_qilingan") {
        try {
          await cleanRestockMarkers(ctx, token, orderKey, []);
        } catch (_) {
          // Cancellation is already complete; a later duplicate request retries cleanup.
        }
      }
      const processed = await publishStatusProjections(
        ctx, token, uid, orderId, orderKey, order, last.from, status, last.transitionVersion, actor
      );
      if (notifyMode === "inline") {
        const dupNotify = scheduleOrderOutbox(execCtx, env, processed.outboxKey);
        if (dupNotify) await dupNotify;
      }
      return json({
        ok: true, duplicate: true, orderKey, status, sideEffects: processed, notify: "server",
        deliver: notifyMode === "split" ? processed.outboxKey : undefined,
      });
    }
    claimed = true;
    const state = claim.state;
    const pending = state.pending;
    const originalStatus = pending.from;
    // Lease faqat 15 s o'tgandagina yangilanadi (LEASE_RENEW_AFTER_MS). Odatiy
    // qabul/yo'lda o'tishida bu 3 ta ketma-ket GET+PUT ni (≈1-1.5 s) tejaydi.
    const statusClock = leaseClock(pending.leaseUntil, STATUS_LEASE_MS);
    /** @type {any} */
    let stockItems = [];
    if (status === "bekor_qilingan") {
      stockItems = await resolveOrderStockItems(ctx, token, order);
      await restockOrderOnce(ctx, token, orderKey, stockItems, owner, pending, statusClock);
    }
    await renewStatusLeaseIfDue(ctx, token, orderKey, owner, pending, statusClock);
    await commitCanonicalStatus(ctx, token, orderPath, uid, orderId, originalStatus, status);
    await renewStatusLeaseIfDue(ctx, token, orderKey, owner, pending, statusClock);
    const loyalty = await applyStatusLoyalty(ctx, token, uid, order, status);
    await renewStatusLeaseIfDue(ctx, token, orderKey, owner, pending, statusClock);
    await completeStatusTransition(ctx, token, orderKey, owner, pending, status);
    // Tiklash belgilari (`_orderOperations`) endi xabar bilan birga FONDA
    // tozalanadi (deliverOrderOutbox): o'tish yakunlangan — ular faqat axlat.
    // Bot sozlanmagan bo'lsa fon yo'q — shu yerda (avvalgidek).
    if (status === "bekor_qilingan" && !env.BOT_TOKEN) {
      try {
        await cleanRestockMarkers(ctx, token, orderKey, stockItems);
      } catch (_) {
        // State and stock are correct; a duplicate request can reconcile marker cleanup.
      }
    }
    const processed = await publishStatusProjections(
      ctx, token, uid, orderId, orderKey, order, originalStatus, status, pending.transitionVersion, actor, loyalty
    );
    // Ko'p tovarli bekor qilish byudjetni ko'p yeydi — eski chaqiruvchi uchun
    // xabar watchdog'ga qoldiriladi (yarim yo'lda uzilib, dublikat bermasin).
    const heavy = status === "bekor_qilingan" && stockItems.length > INLINE_NOTIFY_MAX_ITEMS;
    if (notifyMode === "inline" && !heavy) {
      const notifyTask = scheduleOrderOutbox(execCtx, env, processed.outboxKey);
      if (notifyTask) await notifyTask;
    }
    const restockSkipped = (stockItems && stockItems.skipped) || [];
    return json({
      ok: true, orderKey, from: originalStatus, status, sideEffects: processed,
      notify: "server",
      deliver: notifyMode === "split" ? processed.outboxKey : undefined,
      restockSkipped: restockSkipped.length ? restockSkipped : undefined,
    });
  } catch (err) {
    if (claimed && (!err || !Number.isInteger(err.status) || err.status >= 500)) {
      return errorResponse(httpError(503, "status qisman bajarildi; ayni so'rovni qayta yuboring", { retryable: true }));
    }
    return errorResponse(err);
  }
}

