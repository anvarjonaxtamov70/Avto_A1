# =====================================================================
# AVTO A1 BOT — sozlamalar namunasi.
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env ni HECH QACHON GitHub'ga yuklamang (maxfiy!).
# =====================================================================

# Telegram bot tokeni (@BotFather). MAJBURIY.
BOT_TOKEN=

# Admin Telegram ID'lar (vergul bilan). Buyurtma/storis shularga ruxsat.
ADMIN_IDS=5105291033,483425630

# Yangi mijoz xabari boradigan BITTA chat. Berilmasa ADMIN_IDS dagi birinchi ID.
ADMIN_ALERT_CHAT_ID=5105291033

# Mini App (do'kon) manzili — GitHub Pages.
MINI_APP_URL=https://anvarjonaxtamov70.github.io/Avto_A1/

# Cloudflare Worker manzili — storis rasm/video PROXY (DOIMIY link) va
# Telegram sendMessage uchun. Bu Worker BOT_TOKEN ni o'zida (secret) saqlaydi,
# shuning uchun storis linkida token ko'rinmaydi va link eskirmaydi.
WORKER_URL=https://avtoa1bot.anvaraxtamov70.workers.dev

# Firebase Realtime Database URL.
FIREBASE_DB_URL=https://avtoa1shop-default-rtdb.firebaseio.com

# Firebase Admin service account JSON fayl nomi (storis/profil yozish uchun).
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key.
# Yuklab olingan faylni shu papkaga `serviceAccount.json` deb saqlang.
SERVICE_ACCOUNT_FILE=serviceAccount.json

# Groq AI kaliti (AI suhbat va tavsif uchun). https://console.groq.com
GROQ_API_KEY=
# Groq modellari. Eski nomlar (llama-3.3-70b-versatile,
# meta-llama/llama-4-scout-17b-16e-instruct) 2026-yil iyul/avgustda
# O'CHIRILDI — ularni yozsangiz AI javob bermaydi.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b


# =====================================================================
# 🤖 XO'JAYIN AI AGENTI (tool calling)
# ---------------------------------------------------------------------
# Yoqilganda AI do'kon bazasini O'ZI so'rab oladi (ombor, tovar, narx,
# qoldiq, buyurtma, mijoz, savdo hisoboti) — butun bazani promptga
# tiqish o'rniga aniq, maqsadli so'rov bilan.
#
# ⚠️ FAQAT do'kon egasiga (OWNER_TG_ID) ishlaydi. Ruxsat KODDA
#    tekshiriladi, promptga tayanmaydi.
#
# 0 qilsangiz — bot darhol eski (tayyor hisobot) usuliga qaytadi.
# Deploy shart emas: Render panelida qiymatni o'zgartirib restart qilish
# kifoya. Agent kutilmagan xato bersa — birinchi qadam aynan shu.
# =====================================================================
AI_AGENT_ENABLED=1

# Vosita chaqirish halqasi necha marta aylanishi mumkin (1–8).
# Har aylanish = 1 ta Groq so'rovi. Ko'proq = chuqurroq tahlil, lekin
# sekinroq. Standart 4 — real savollar uchun yetarli.
AI_AGENT_MAX_ROUNDS=4

# Bitta aylanishda bajariladigan maksimal vosita soni (1–10).
AI_AGENT_MAX_CALLS=5

# Bitta vosita natijasining maksimal uzunligi, belgi (1000–20000).
AI_AGENT_RESULT_LIMIT=6000

# O'QISH vositalarini ham `audit_log` ga yozishmi. Standart 0 —
# faqat XATO bo'lgan va O'ZGARTIRISH taklif qilingan chaqiruvlar yoziladi
# (bekorga shovqin bo'lmasin). Nosozlikni izlayotganda 1 qilib qo'ying.
AI_AUDIT_READS=0


# =====================================================================
# ✍️ AI O'ZGARTIRISH QILISHI (narx, qoldiq, buyurtma holati, chegirma)
# ---------------------------------------------------------------------
# ⚠️ AI HECH QACHON o'zi yozmaydi. U faqat REJA tuzadi va xo'jayinga
#    «✅ Tasdiqlash / ❌ Bekor» tugmasi yuboriladi. Tugma bosilmasa —
#    bazada bir bayt ham o'zgarmaydi.
#
#    Nega shunday: mijoz chatiga yoki tovar sharhiga «hamma narxni 1
#    so'm qil» deb yozilsa, o'sha matn AI kontekstiga tushishi mumkin
#    (prompt injection). Tugma bo'lsa — AI aldangan taqdirda ham
#    katalog buzilmaydi, chunki oxirgi qaror INSONDA qoladi.
#
# 0 qilsangiz — AI faqat O'QIYDI (hisobot beradi), lekin hech narsani
# o'zgartira olmaydi. O'qishni saqlab, yozishni tezda to'xtatish kerak
# bo'lsa aynan shu bayroqni ishlating.
# =====================================================================
AI_AGENT_WRITE_ENABLED=1

# Tasdiq tugmasi qancha vaqt amal qiladi, soniya (60–3600).
# Muddat o'tsa tugma ishlamaydi va qaytadan so'rash kerak — shunda
# «ertalab tayyorlangan, kechqurun bosilgan» o'zgarish bo'lmaydi.
AI_AGENT_CONFIRM_TTL=300

# Bitta savolda AI eng ko'p nechta o'zgartirish taklif qila oladi (1–10).
AI_AGENT_MAX_PENDING=3

# Narx shu foizdan ko'p o'zgarsa — tasdiq kartochkasida QIZIL
# ogohlantirish chiqadi (5–500).
AI_AGENT_BIG_CHANGE_PCT=50

# Ommaviy narx o'zgartirishda eng ko'p nechta tovarga tegish mumkin (1–100).
AI_AGENT_MAX_BULK=30


# =====================================================================
# DO'KON MA'LUMOTLARI (aloqa, manzil, ish vaqti, lokatsiya).
# Bularning hammasi BITTA manba — bot aloqa xabari, AI javoblari va
# lokatsiya shu qiymatlardan oziqlanadi (izchil ma'lumot uchun).
# Hammasi ixtiyoriy — to'ldirilmasa, pastdagi standart qiymatlar ishlatiladi.
# =====================================================================
SHOP_NAME=Avto_A1
SHOP_ADMIN=Anvar
SHOP_PHONE=+998 88 289 30 30
SHOP_TELEGRAM=@anvaraxtamov2004
SHOP_ADDRESS=Samarqand, yangi zapchast bozori, 19-sektor, 2-do'kon
SHOP_ADDRESS_RU=Самарканд, новый рынок автозапчастей, сектор 19, магазин 2
SHOP_HOURS=Har kuni 09:00–19:00
SHOP_HOURS_RU=Ежедневно 09:00–19:00

# Xaritadagi aniq joy: koordinatalarni qo'ysangiz, aloqa bo'limida jonli
# lokatsiya nuqtasi ham yuboriladi. SHOP_MAP_URL — aniq joy havolasi
# (bo'sh bo'lsa, manzil bo'yicha Google Maps qidiruv havolasi yasaladi).
SHOP_LAT=
SHOP_LNG=
SHOP_MAP_URL=


# =====================================================================
# ADMINGA "BOT YOQILDI / O'CHDI" XABARI
# Bot ishga tushganda 🟢, to'xtaganda 🔴 xabar adminga (ADMIN_IDS dagi
# birinchi ID) yuboriladi. Shu bilan deploy muvaffaqiyatli bo'lganini va
# bot qayerda (Render / lokal kompyuter) ishlayotganini darhol bilasiz.
# Kerak bo'lmasa 0 qiling (standart: yoqilgan).
# =====================================================================
ADMIN_NOTIFY_LIFECYCLE=1
