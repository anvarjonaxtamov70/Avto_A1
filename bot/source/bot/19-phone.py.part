def normalize_phone(text):
    """Matnli raqamni +998XXXXXXXXX ko'rinishiga keltiradi. Yaroqsiz bo'lsa None."""
    if not text:
        return None
    digits = re.sub(r"\D", "", str(text))
    if len(digits) == 12 and digits.startswith("998"):
        core = digits[3:]
    elif len(digits) == 9:
        core = digits
    else:
        return None
    if not re.fullmatch(r"\d{9}", core):
        return None
    return "+998" + core


