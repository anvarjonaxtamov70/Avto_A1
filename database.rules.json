{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "users": {
      ".read": true,
      ".write": true,

      "$uid": {
        "profile": {
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "address": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "lang": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        },

        "orders": {
          "$orderIdx": {
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000000"
            },
            "payable": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (!newData.parent().child('total').isNumber() || newData.val() <= newData.parent().child('total').val())"
            },
            "cashbackUsed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (!newData.parent().child('total').isNumber() || newData.val() <= newData.parent().child('total').val())"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(kutilmoqda|qabul|yolda|yetkazildi|bekor_qilingan)$/)"
            }
          }
        },

        "phase2": {
          "cashbackTotal": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && ((!data.exists() && newData.val() <= 1000000) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 1000000))"
          },
          "cashbackSpent": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && ((!data.exists() && newData.val() <= 1000000) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 1000000))"
          },
          "cashbackRefunded": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && ((!data.exists() && newData.val() <= 1000000) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 1000000))"
          },
          "cashback": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "referralPaid": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "newData.exists()",
      ".indexOn": ["createdAt", "status", "uid"],

      "$orderKey": {
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000000"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(kutilmoqda|qabul|yolda|yetkazildi|bekor_qilingan)$/)"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },

    "products": {
      ".read": true,
      ".write": "newData.exists()",

      "$productIdx": {
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000000"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      }
    },

    "stories": {
      ".read": true,
      ".write": "newData.exists()"
    },

    "bts_branches": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "broadcasts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "reviews": {
      ".read": true,
      ".write": "newData.exists()",

      "$productId": {
        "$uid": {
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "userName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        }
      }
    },

    "refcodes": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },

    "referralRedeemed": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "referrals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      ".indexOn": ["paid", "date"],
      "$inviterUid": {
        ".read": "auth != null && (auth.uid === $inviterUid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "notify_requests": {
      ".read": true,
      ".write": true
    },

    "ai_requests": {
      ".read": true,
      ".write": true
    },

    "ai_bulk_requests": {
      ".read": true,
      ".write": true,

      "$uid": {
        "usd_rate": {
          ".validate": "!newData.isNumber() || (newData.val() > 0 && newData.val() <= 1000000)"
        },
        "markup_pct": {
          ".validate": "!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 1000)"
        }
      }
    },

    "ai_admin_tasks": {
      ".read": true,
      ".write": true
    },

    "pending_actions": {
      "//": "AI tasdiq kutayotgan o'zgarishlar. FAQAT bot (service account) o'qiydi va yozadi — u qoidalarni chetlab o'tadi. Mijoz uchun to'liq YOPIQ: aks holda begona odam token'ni ko'rib, tasdiqlanmagan amalni o'zgartirishi mumkin edi.",
      ".read": false,
      ".write": false
    },

    "audit_log": {
      "//": "AI qilgan har bir o'zgarishning jurnali (oldingi qiymat bilan) — '/orqaga' buyrug'i shundan o'qiydi. Mijoz uchun YOPIQ: bu yerda narx tarixi va buyurtma ma'lumotlari bor.",
      ".read": false,
      ".write": false
    }
  }
}
