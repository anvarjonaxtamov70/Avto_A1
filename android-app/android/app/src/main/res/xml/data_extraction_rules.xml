<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ilova ma'lumotlari (kirish sessiyasi, kesh) bulutga ham,
     yangi telefonga ko'chirishda ham nusxalanmaydi. Yangi qurilmada mijoz
     raqami bilan qayta kiradi (Telegram orqali tasdiq). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
